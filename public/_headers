# Cloudflare static-asset headers (read by Workers Assets).
# Hashed Next.js bundles and versioned fonts never change, so browsers can keep
# them forever instead of re-validating every file on every visit.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/icon-192.png
  Cache-Control: public, max-age=604800

/icon-512.png
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/favicon-32.png
  Cache-Control: public, max-age=604800
